{
  "expo": {
    "name": "RotaGuia",
    "slug": "RotaGuia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Este app precisa acessar a câmera.",
        "NSLocationWhenInUseUsageDescription": "Este app precisa acessar sua localização.",
        "NSFaceIDUsageDescription": "Este app usa o Face ID para autenticação.",
        "NSPhotoLibraryUsageDescription": "Este app precisa acessar suas fotos."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed9dd96b-4776-4d71-8bb8-52563f7b60f4"
      }
    },
    "android": {
      "package": "com.victor2822.RotaGuia",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}
